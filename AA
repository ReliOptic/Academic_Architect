#!/usr/bin/env python3
from __future__ import annotations

import argparse
import atexit
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import webbrowser
from pathlib import Path


ROOT = Path(__file__).resolve().parent
VENV_DIR = ROOT / ".venv"
ENV_FILE = ROOT / ".env"
ENV_EXAMPLE = ROOT / ".env.example"
NODE_MODULES = ROOT / "node_modules"
FRONTEND_URL = "http://localhost:3000"
BACKEND_URL = "http://localhost:8000/api/health"


class OnboardError(RuntimeError):
    pass


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="AA",
        description="Academic Architect launcher",
    )
    parser.add_argument(
        "--onboard",
        action="store_true",
        help="Bootstrap dependencies, start backend/frontend, and open the browser.",
    )
    parser.add_argument(
        "--no-browser",
        action="store_true",
        help="Start services without opening the browser.",
    )
    parser.add_argument(
        "--frontend-only",
        action="store_true",
        help="Start only the frontend dev server.",
    )
    parser.add_argument(
        "--backend-only",
        action="store_true",
        help="Start only the backend server.",
    )
    parser.add_argument(
        "--print-install-snippet",
        action="store_true",
        help="Print the shell snippet for adding AA to your PATH.",
    )
    parser.add_argument(
        "--upload",
        metavar="FILE",
        help="Upload a study file and jump straight into the learning HUD.",
    )
    return parser.parse_args()


def ensure_command(name: str) -> str:
    path = shutil.which(name)
    if not path:
        raise OnboardError(f"Required command not found: {name}")
    return path


def run(cmd: list[str], *, env: dict[str, str] | None = None) -> None:
    completed = subprocess.run(cmd, cwd=ROOT, env=env, check=False)
    if completed.returncode != 0:
        quoted = " ".join(cmd)
        raise OnboardError(f"Command failed ({completed.returncode}): {quoted}")


def ensure_env_file() -> None:
    if not ENV_FILE.exists() and ENV_EXAMPLE.exists():
        shutil.copyfile(ENV_EXAMPLE, ENV_FILE)


def ensure_python_env(python_bin: str) -> Path:
    venv_python = VENV_DIR / "bin" / "python"
    if not venv_python.exists():
        run([python_bin, "-m", "venv", str(VENV_DIR)])
    return venv_python


def ensure_python_dependencies(venv_python: Path) -> None:
    try:
        subprocess.run(
            [str(venv_python), "-c", "import uvicorn, fastapi"],
            cwd=ROOT,
            check=True,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except subprocess.CalledProcessError:
        run([str(venv_python), "-m", "pip", "install", "-r", "requirements.txt"])


def ensure_node_dependencies(npm_bin: str) -> None:
    if not NODE_MODULES.exists():
        run([npm_bin, "install"])


def port_open(host: str, port: int) -> bool:
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.settimeout(0.5)
        return sock.connect_ex((host, port)) == 0


def wait_for_port(host: str, port: int, *, timeout: float) -> None:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if port_open(host, port):
            return
        time.sleep(0.5)
    raise OnboardError(f"Timed out waiting for {host}:{port}")


def spawn(cmd: list[str], *, env: dict[str, str] | None = None) -> subprocess.Popen[str]:
    return subprocess.Popen(
        cmd,
        cwd=ROOT,
        env=env,
        text=True,
    )


def stop_process(proc: subprocess.Popen[str] | None) -> None:
    if not proc or proc.poll() is not None:
        return
    proc.terminate()
    try:
        proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        proc.kill()


def upload_session(
    file_path: Path, *, host: str = "127.0.0.1", port: int = 8000, timeout: float = 180.0
) -> str:
    """POST file to /api/sessions and return the new session_id."""
    import json
    import mimetypes
    import urllib.request
    import uuid

    boundary = uuid.uuid4().hex
    mime, _ = mimetypes.guess_type(file_path.name)
    mime = mime or "application/octet-stream"

    crlf = b"\r\n"
    parts = [
        f"--{boundary}".encode(),
        f'Content-Disposition: form-data; name="file"; filename="{file_path.name}"'.encode(),
        f"Content-Type: {mime}".encode(),
        b"",
        file_path.read_bytes(),
        f"--{boundary}--".encode(),
        b"",
    ]
    body = crlf.join(parts)

    req = urllib.request.Request(
        f"http://{host}:{port}/api/sessions",
        data=body,
        headers={"Content-Type": f"multipart/form-data; boundary={boundary}"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    session_id = payload.get("session_id")
    if not session_id:
        raise OnboardError(f"Upload succeeded but session_id missing: {payload!r}")
    return session_id


def onboard(
    no_browser: bool,
    frontend_only: bool,
    backend_only: bool,
    upload: str | None = None,
) -> int:
    if frontend_only and backend_only:
        raise OnboardError("Choose only one of --frontend-only or --backend-only.")
    upload_path: Path | None = None
    if upload:
        if frontend_only or backend_only:
            raise OnboardError("--upload requires both backend and frontend; remove --frontend-only/--backend-only.")
        upload_path = Path(upload).expanduser().resolve()
        if not upload_path.is_file():
            raise OnboardError(f"Upload target not found: {upload_path}")

    python_bin = ensure_command("python3")
    npm_bin = ensure_command("npm")

    ensure_env_file()

    backend_proc: subprocess.Popen[str] | None = None
    frontend_proc: subprocess.Popen[str] | None = None

    atexit.register(stop_process, backend_proc)
    atexit.register(stop_process, frontend_proc)

    if not frontend_only:
        venv_python = ensure_python_env(python_bin)
        ensure_python_dependencies(venv_python)
        backend_proc = spawn(
            [
                str(venv_python),
                "-m",
                "uvicorn",
                "server.main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
            ]
        )
        wait_for_port("127.0.0.1", 8000, timeout=30)

    if not backend_only:
        ensure_node_dependencies(npm_bin)
        frontend_proc = spawn([npm_bin, "run", "dev"])
        wait_for_port("127.0.0.1", 3000, timeout=30)

    target_url = FRONTEND_URL
    if upload_path is not None:
        print(f"[AA] Uploading {upload_path.name}...")
        try:
            session_id = upload_session(upload_path)
        except urllib.error.HTTPError as exc:
            raise OnboardError(f"Upload failed ({exc.code}): {exc.read().decode('utf-8', 'replace')}")
        except Exception as exc:
            raise OnboardError(f"Upload failed: {exc}") from exc
        print(f"[AA] Session created: {session_id}")
        target_url = f"{FRONTEND_URL}/?session={session_id}"

    if not no_browser and not backend_only:
        webbrowser.open(target_url)

    print("Academic Architect is running.")
    if not frontend_only:
        print(f"Backend:  {BACKEND_URL}")
    if not backend_only:
        print(f"Frontend: {target_url}")
    print("Press Ctrl+C to stop.")

    processes = [proc for proc in (backend_proc, frontend_proc) if proc]

    def handle_signal(signum: int, frame: object) -> None:
        for proc in processes:
            stop_process(proc)
        raise SystemExit(0)

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    try:
        while True:
            for proc in processes:
                code = proc.poll()
                if code is not None:
                    raise OnboardError(f"Process exited early with code {code}: {' '.join(proc.args)}")
            time.sleep(1)
    finally:
        for proc in processes:
            stop_process(proc)


def print_install_snippet() -> int:
    target = ROOT / "AA"
    snippet = f"""mkdir -p "$HOME/.local/bin"
ln -sf "{target}" "$HOME/.local/bin/academic-architect"
grep -q 'export PATH="$HOME/.local/bin:$PATH"' "$HOME/.zshrc" || echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.zshrc"
grep -q "alias AA='{target}'" "$HOME/.zshrc" || echo "alias AA='{target}'" >> "$HOME/.zshrc"
source "$HOME/.zshrc"
AA --help
academic-architect --help
"""
    print(snippet)
    return 0


def main() -> int:
    args = parse_args()
    if args.print_install_snippet:
        return print_install_snippet()
    if not args.onboard:
        print("Use `./AA --onboard` to bootstrap and run Academic Architect.")
        return 0

    try:
        return onboard(
            args.no_browser,
            args.frontend_only,
            args.backend_only,
            upload=args.upload,
        )
    except OnboardError as exc:
        print(f"[AA] {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
